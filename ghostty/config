# Ghostty configuration - managed by dotfiles (lazy branch)

# Tab operations
keybind = alt+t=new_tab
keybind = alt+b=previous_tab
keybind = alt+n=next_tab
keybind = alt+shift+b=move_tab:-1
keybind = alt+shift+n=move_tab:1

# Pane (split) operations
keybind = ctrl+h=new_split:left
keybind = ctrl+v=new_split:down
keybind = ctrl+b=goto_split:previous
keybind = ctrl+n=goto_split:next
keybind = ctrl+q=close_surface
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10
keybind = ctrl+shift+k=resize_split:up,10
keybind = ctrl+shift+j=resize_split:down,10

# Clipboard operations
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Appearance
font-family = Hack Nerd Font Mono
font-size = 11
theme = Kanagawa Wave
